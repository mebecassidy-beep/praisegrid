# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Places API (New) — powers the live business lookup on the home page
# and the exit-intent lead report. Server-side only, never expose to the client.
# Setup: Google Cloud Console > enable "Places API (New)" > Credentials > Create API key
# > restrict the key to Places API (New) and to your server's IP/referrer as appropriate.
# Home page lookup gracefully falls back to a "Start Free Trial" CTA until this is set.
GOOGLE_PLACES_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Praisegrid <support@praisegrid.com>

# Support escalation
SUPPORT_INBOX_EMAIL=

# Cron auth (Vercel Cron sends this as a Bearer token automatically)
CRON_SECRET=

# Twilio (crisis SMS alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OAuth token storage — shared by every platform_connections row (Google
# Business Profile, Facebook), not platform-specific.
# TOKEN_ENCRYPTION_KEY: base64-encoded 32 random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# OAUTH_STATE_SECRET: any long random string, signs the OAuth `state` param.
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# Google Business Profile OAuth (full review history + real reply-posting,
# beyond GOOGLE_PLACES_API_KEY's read-only 5-review cap above).
# Setup: Google Cloud Console > enable "Google Business Profile API" (needs
# Google's approval for API access) > Credentials > OAuth client ID (Web
# application) > add redirect URI: <site-url>/api/auth/google-business/callback
# Falls back to the Places API sync until this is set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Facebook Page review sync (read-only — Meta's Graph API has no endpoint to
# post a reply to a Page rating).
# Setup: developers.facebook.com > Create App (type: Business) > Facebook
# Login for Business > add redirect URI: <site-url>/api/auth/facebook/callback
# > request pages_show_list, pages_read_engagement, pages_read_user_content.
# "Coming soon" in the UI until this is set.
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
